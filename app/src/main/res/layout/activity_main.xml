<?xml version="1.0" encoding="utf-8"?>
<!-- Pantalla principal con el diseño "Agenda": tira de la semana, pestañas tipo píldora,
     barra de chips (filtro, orden, secciones, notas, SMS) y lista por día con línea de tiempo. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/fondo"
    android:orientation="vertical">

    <TextView
        android:id="@+id/aviso"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/boton"
        android:backgroundTint="@color/aviso_fondo"
        android:padding="14dp"
        android:textColor="@color/aviso_texto"
        android:textSize="15sp"
        android:visibility="gone" />

    <!-- Aviso de versión nueva (se lee de las Releases de GitHub) -->
    <TextView
        android:id="@+id/avisoVersion"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="16dp"
        android:layout_marginBottom="8dp"
        android:background="@drawable/boton_principal"
        android:padding="12dp"
        android:textColor="@color/sobre_acento"
        android:textSize="15sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <!-- Tira de la semana: tocar un día filtra por ese día; tocarlo de nuevo vuelve a "Todos". -->
    <TextView
        android:id="@+id/tvSemana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="20dp"
        android:paddingTop="2dp"
        android:textColor="@color/texto2"
        android:textSize="13sp"
        android:fontFamily="sans-serif-medium" />

    <LinearLayout
        android:id="@+id/semana"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="14dp"
        android:paddingVertical="8dp" />

    <!-- Pestañas: Pendientes y Recordatorios (píldoras) -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp"
        android:paddingBottom="4dp">

        <LinearLayout
            android:id="@+id/tabPendientes"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:layout_marginEnd="8dp"
            android:background="@drawable/chip"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvTabPendientes"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Pendientes (0)"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/tabRecordatorios"
            android:layout_width="wrap_content"
            android:layout_height="40dp"
            android:background="@drawable/chip_on"
            android:gravity="center"
            android:orientation="vertical"
            android:paddingHorizontal="16dp">

            <TextView
                android:id="@+id/tvTabRecordatorios"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:text="Recordatorios"
                android:textSize="14sp" />
        </LinearLayout>
    </LinearLayout>

    <!-- ===================== Pestaña PENDIENTES ===================== -->
    <LinearLayout
        android:id="@+id/panelPendientes"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical"
        android:visibility="gone">

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/listaPendientes"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingTop="8dp" />
        </ScrollView>

        <Button
            android:id="@+id/btnNuevoPendiente"
            style="@style/Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="+ Carga de «Pendiente»" />
    </LinearLayout>

    <!-- ===================== Pestaña RECORDATORIOS ===================== -->
    <LinearLayout
        android:id="@+id/panelRecordatorios"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <!-- Barra de chips: filtro, orden, secciones, notas y SMS (se desliza a los costados) -->
        <HorizontalScrollView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingHorizontal="16dp"
            android:paddingVertical="8dp"
            android:scrollbars="none">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/btnFiltro"
                    style="@style/Boton.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="⏷ Filtro: Todos" />

                <Button
                    android:id="@+id/btnOrden"
                    style="@style/Boton.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="⇅ Orden" />

                <Button
                    android:id="@+id/btnSecciones"
                    style="@style/Boton.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Secciones ▾" />

                <Button
                    android:id="@+id/btnSubsecciones"
                    style="@style/Boton.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Subsecciones ▾" />

                <Button
                    android:id="@+id/btnNotas"
                    style="@style/Boton.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:layout_marginEnd="8dp"
                    android:text="Ocultar notas" />

                <Button
                    android:id="@+id/btnSms"
                    style="@style/Boton.Chip"
                    android:layout_width="wrap_content"
                    android:layout_height="40dp"
                    android:text="Suspender/Anular SMS" />
            </LinearLayout>
        </HorizontalScrollView>

        <TextView
            android:id="@+id/avisoSms"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/boton"
            android:backgroundTint="@color/rojo_suave"
            android:gravity="center"
            android:padding="10dp"
            android:text="Envíos SMS se encuentran SUSPENDIDOS/ANULADOS"
            android:textColor="@color/rojo"
            android:textSize="14sp"
            android:textStyle="bold"
            android:visibility="gone" />

        <TextView
            android:id="@+id/avisoFiltro"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:layout_marginBottom="6dp"
            android:background="@drawable/boton"
            android:backgroundTint="@color/acento_suave"
            android:gravity="center"
            android:padding="8dp"
            android:textColor="@color/texto"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/barraSeleccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="16dp"
            android:background="@drawable/boton"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvSeleccion"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:textStyle="bold" />

            <Button
                android:id="@+id/btnAcciones"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textColor="@color/acento"
                android:text="Acciones ▾" />

            <Button
                android:id="@+id/btnCancelarSeleccion"
                style="?android:attr/borderlessButtonStyle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textAllCaps="false"
                android:textColor="@color/texto2"
                android:text="Cancelar" />
        </LinearLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <LinearLayout
                android:id="@+id/lista"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingHorizontal="16dp"
                android:paddingBottom="8dp" />
        </ScrollView>

        <Button
            android:id="@+id/btnNuevo"
            style="@style/Boton.Principal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="16dp"
            android:text="+ Nuevo recordatorio" />
    </LinearLayout>
</LinearLayout>
