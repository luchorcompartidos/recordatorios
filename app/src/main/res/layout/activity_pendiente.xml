<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <EditText
            android:id="@+id/etPendTitulo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Título (obligatorio)"
            android:inputType="textCapSentences"
            android:maxLines="1" />

        <EditText
            android:id="@+id/etPendNota"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:hint="Nota (opcional)"
            android:inputType="textCapSentences|textMultiLine"
            android:minLines="3" />

        <Button
            android:id="@+id/btnPendGuardar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="28dp"
            android:text="Guardar" />

        <Button
            android:id="@+id/btnPendCrear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Crear Recordatorio" />

        <Button
            android:id="@+id/btnPendBorrar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Borrar"
            android:visibility="gone" />
    </LinearLayout>
</ScrollView>
